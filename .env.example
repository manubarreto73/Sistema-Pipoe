# Plantilla de las variables que necesita docker-compose. Copiar a `.env` y completar.
# El `.env` real NUNCA se versiona: está en el .gitignore. En el servidor va con permisos 600.
#
#   cp .env.example .env

# --- Base de datos ------------------------------------------------------------------------
DB_NAME=pipoe
# No usar `postgres` en producción: un rol propio hace que un descuido no sea superusuario.
DB_USERNAME=pipoe
# Generada y larga. Nunca reutilizada de otro servicio.
DB_PASSWORD=

# --- Redis --------------------------------------------------------------------------------
# Sin contraseña, cualquier cosa que llegue a la red lee los refresh tokens de todas las
# sesiones abiertas.
REDIS_PASSWORD=

# --- Firma de los tokens ------------------------------------------------------------------
# Obligatoria: sin esto la aplicación no arranca, a propósito. Generarla con:
#   openssl rand -base64 48
# Cambiarla invalida todos los tokens de acceso en circulación.
JWT_SECRET_KEY=

# --- Primer administrador -----------------------------------------------------------------
# Sólo se usan si la base todavía no tiene ningún ADMIN. Cambiar la contraseña en el primer
# login y después borrar estas dos líneas del .env del servidor.
ADMIN_INICIAL_EMAIL=
ADMIN_INICIAL_PASSWORD=
ADMIN_INICIAL_NOMBRE=Administrador

# --- Correo -------------------------------------------------------------------------------
# El sistema depende de esto: las contraseñas de usuarios y colaboradores viajan sólo por
# mail. Si el correo no sale, nadie puede entrar. Usar un servicio transaccional (Brevo,
# Resend), no una cuenta personal de Gmail.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Tiene que ser un dominio con SPF y DKIM configurados o los mensajes caen en spam.
MAIL_FROM=no-reply@ejemplo.com

# --- Dominio ------------------------------------------------------------------------------
# El dominio exacto con esquema, separados por coma si hay más de uno. NUNCA `*`: la
# configuración manda credenciales, y el navegador rechaza el comodín combinado con ellas.
# Sirviendo front y API bajo el mismo origen esto casi no se usa, pero conviene dejarlo bien.
CORS_ALLOWED_ORIGINS=https://ejemplo.com

# Puerto del host donde escucha el sitio. En el servidor va 80 (con el proxy de TLS adelante);
# en la máquina local conviene otro para no chocar con lo que ya esté escuchando.
FRONT_PORT=80

# --- Ajustes opcionales -------------------------------------------------------------------
# Intentos fallidos de login antes de bloquear, por IP y por cuenta.
# MAX_LOGIN_ATTEMPTS=5
# MAX_LOGIN_ATTEMPTS_CUENTA=10
# Tope de solicitudes de acceso por IP y hora, del formulario público.
# MAX_SOLICITUDES_ACCESO=3
# Activar SÓLO cuando haya un proxy delante que pise X-Forwarded-For con la IP real. Con esto
# en true sin el proxy bien configurado, el bloqueo por intentos se vuelve evadible.
# TRUST_PROXY=false
