# Variables del servidor. Copiar a `deploy/.env` — o mejor, generarlo con:
#
#   bash generar-env.sh
#
# El `.env` real NUNCA se versiona y va con permisos 600. Está en el .gitignore de la raíz.

# --- Dominio ------------------------------------------------------------------------------
# Sin esquema y sin barra: pipoe.ejemplo.com. Lo usan nginx y certbot.
DOMINIO=
# A dónde avisa Let's Encrypt si un certificado está por vencer sin haberse renovado.
CERTBOT_EMAIL=

# --- Base de datos ------------------------------------------------------------------------
DB_NAME=pipoe
# No usar `postgres`: un rol propio hace que un descuido no sea superusuario.
DB_USERNAME=pipoe
# OJO: esta contraseña queda grabada en el volumen de Postgres en el PRIMER arranque.
# Cambiarla después en el .env no cambia la de la base y la API deja de conectarse; hace falta
# un ALTER USER o borrar el volumen.
DB_PASSWORD=

# --- Redis --------------------------------------------------------------------------------
# Sin contraseña, cualquier cosa que llegue a la red lee los refresh tokens de todas las
# sesiones abiertas.
REDIS_PASSWORD=

# --- Firma de los tokens ------------------------------------------------------------------
# Obligatoria: sin esto la aplicación no arranca, a propósito.
# Cambiarla invalida todos los tokens en circulación y cierra todas las sesiones.
JWT_SECRET_KEY=

# --- Primer administrador -----------------------------------------------------------------
# Sólo se usan si la base todavía no tiene ningún ADMIN. Cambiar la contraseña en el primer
# login y después borrar estas líneas del .env del servidor.
#
# La contraseña necesita AL MENOS 12 caracteres. Con menos, AdminBootstrap registra un error y
# no crea la cuenta: la aplicación arranca perfecta y el login dice "credenciales inválidas".
ADMIN_INICIAL_EMAIL=
ADMIN_INICIAL_PASSWORD=
ADMIN_INICIAL_NOMBRE=Administrador

# --- Correo -------------------------------------------------------------------------------
# El sistema depende de esto: las contraseñas de usuarios y colaboradores viajan SÓLO por
# correo. Si el correo no sale, nadie puede dar de alta a nadie. Ver docs/correo.md.
#
# Servicio transaccional (Brevo), nunca una cuenta personal de Gmail: no se le pueden agregar
# registros DNS a gmail.com, así que no hay forma de autenticar el remitente.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
# OJO: lo genera Brevo y NO es el remitente. Tiene forma 9a1b2c001@smtp-brevo.com.
MAIL_USERNAME=
# La clave SMTP del panel de Brevo, no la contraseña de la cuenta.
MAIL_PASSWORD=
# Esto sí lo elegimos nosotros. No necesita ser un buzón que exista: lo que lo hace legítimo
# son los registros SPF y DKIM de modelopipoe.com, no que haya alguien detrás leyendo.
MAIL_FROM=no-reply@modelopipoe.com

# --- Dominio para CORS --------------------------------------------------------------------
# El dominio exacto con esquema. NUNCA `*`: la configuración manda credenciales y el navegador
# rechaza el comodín combinado con ellas. Sirviendo front y API bajo el mismo origen esto casi
# no se usa, pero conviene dejarlo bien.
CORS_ALLOWED_ORIGINS=https://ejemplo.com

# --- Backups ------------------------------------------------------------------------------
BACKUP_DIR=/var/backups/pipoe
BACKUP_RETENTION_DAYS=30
